# Complete Clever Cloud production template; copy to .env.deploy and edit.
# Import with: clever env import < .env.deploy
# Import replaces all application variables. Never commit real credentials.
# Local GitHub CLI use needs no .env file or environment variables.
CC_RUST_BIN=github-dashboard
CC_CACHE_DEPENDENCIES=true
CC_REQUEST_FLOW=oauth2-proxy
CC_HEALTH_CHECK_PATH=/health
PORT=9000
DASHBOARD_AUTH=proxy
# GitHub usernames, not email addresses; separate multiple usernames with commas.
DASHBOARD_ALLOWED_USERS=your-github-username
# Optional: omit to open the signed-in user's personal account.
# GITHUB_DEFAULT_OWNER=your-organization

OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_CLIENT_ID=replace-with-github-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-github-client-secret
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=replace-with-generated-cookie-secret
OAUTH2_PROXY_REDIRECT_URL=https://forge.example.com/oauth2/callback
OAUTH2_PROXY_SCOPE="read:user user:email read:org repo"
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_REVERSE_PROXY=true
# No email-domain restriction: Forge enforces DASHBOARD_ALLOWED_USERS by username.
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/health$
# Send visitors directly to GitHub; API clients receive 401 when signed out.
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_API_ROUTES=^/api/

# Optional runtime tuning (defaults shown; numeric values must be positive).
# Complete cache lifetime in seconds; a manual Refresh always bypasses it.
DASHBOARD_CACHE_TTL_SECONDS=1800
# Per-instance synchronization and GitHub request limits.
DASHBOARD_MAX_CONCURRENT_SYNCS=4
DASHBOARD_SYNC_TIMEOUT_SECONDS=120
GITHUB_REQUEST_TIMEOUT_SECONDS=30
GITHUB_MAX_CONCURRENT_REPOSITORIES=4
